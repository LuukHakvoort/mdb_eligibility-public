\clvertalc \clshdrawnil \clwWidth14353\clftsWidth3 \clmart10 \clmarl10 \clmarb10 \clmarr10 \clbrdrt\brdrnil \clbrdrl\brdrnil \clbrdrb\brdrnil \clbrdrr\brdrnil \clpadt20 \clpadl20 \clpadb20 \clpadr20 \gaph\cellx8640
\pard\intbl\itap1\pardeftab720\partightenfactor0

\f1\b \cf0 2014\'962020
\f0\b0 \cell 
\pard\intbl\itap1\pardeftab720\partightenfactor0
\cf0 Russia remained legally listed but new operations were suspended; Belarus was activated in 2016; Brunei, Chile, Iceland, Israel, Singapore and South Korea were removed in 2018; Iran was added in 2018. {\field{\*\fldinst{HYPERLINK "https://eur-lex.europa.eu/eli/dec/2014/466%281%29/oj/eng?utm_source=chatgpt.com"}}{\fldrslt \cf3 \ul \ulc3 \strokec3 EUR-Lex}}\cell \row

