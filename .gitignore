# Byte-compiled Python
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/

# Cached raw downloads (see docs/architecture.md); never committed
data/raw/

# Generated reports: regenerated by `make validate` on every run, and they
# churn with every edit to the manual data. data/output/eligibility.csv is the
# thesis deliverable and is NOT ignored.
data/output/reports/

# Personal working copies of manual data: a duplicate of what a committed CSV
# already holds, in a format git can't diff or merge. accession_dates.csv is
# the source of truth; merge changes back with scripts/merge_accession_dates.py.
data/manual/*.numbers

# macOS
.DS_Store

# Stray R session files
.Rhistory
